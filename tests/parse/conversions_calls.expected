      (decl u8 (var b (convert u8 (name a))))
      (decl f64 (var c (binary * (convert f64 (name a)) (float 2))))
      (decl bool (var d (convert bool (name a))))
      (decl i32 (var e (convert i32 (name c))))
      (decl i32 (var r (call (name g) (int 1) (float 2))))
      (expr (call (name g) (call (name g) (int 1) (float 2)) (convert f64 (convert i32 (int 3))))))))
