module control

fn both(_0: bool, _1: bool) -> bool {
    let _2: bool;
  bb0:
    branch _0 -> bb1, bb2
  bb1:
    _2 = _1
    goto bb3
  bb2:
    _2 = const false
    goto bb3
  bb3:
    return _2
}

fn pick(_0: bool, _1: i32, _2: i32) -> i32 {
    let _3: i32;
  bb0:
    branch _0 -> bb1, bb2
  bb1:
    _3 = _1
    goto bb3
  bb2:
    _3 = _2
    goto bb3
  bb3:
    return _3
}

fn count(_0: i32) -> i32 {
    let _1: i32; // total
    let _2: i32; // i
    let _3: bool;
    let _4: bool;
    let _5: bool;
    let _6: i32;
    let _7: bool;
  bb0:
    _1 = const 0i32
    _2 = const 0i32
    goto bb1
  bb1:
    _3 = lt(_2, _0)
    branch _3 -> bb2, bb4
  bb2:
    _4 = eq(_2, const 3i32)
    branch _4 -> bb5, bb6
  bb3:
    _6 = _2
    (_2, _7) = checked_add(_2, const 1i32)
    assert !_7, "integer overflow in '++'" -> bb9
  bb4:
    return _1
  bb5:
    goto bb3
  bb6:
    (_1, _5) = checked_add(_1, _2)
    assert !_5, "integer overflow in '+'" -> bb8
  bb7:
    goto bb6
  bb8:
    goto bb3
  bb9:
    goto bb1
}

fn forever() -> void {
  bb0:
    goto bb1
  bb1:
    branch const true -> bb2, bb3
  bb2:
    goto bb1
  bb3:
    return
}
